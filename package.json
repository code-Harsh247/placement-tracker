{
  "name": "placement-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal placement application tracker on Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply placement-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply placement-tracker --remote",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "jose": "6.2.14"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  }
}
